<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.KPIWeb.Login" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/auth_brand_purple</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/auth_brand_purple_bright</item>
        <item name="colorSurface">@color/auth_card_bg</item>
        <item name="colorOnSurface">@color/auth_ink</item>
        <item name="colorOnSurfaceVariant">@color/auth_muted</item>
        <item name="colorOutline">@color/auth_border</item>
        <item name="colorError">@color/auth_error</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/auth_background</item>
        <item name="android:navigationBarColor">@color/auth_background_bottom</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowBackground">@color/auth_background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/auth_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/auth_splash_icon</item>
    </style>

    <style name="Widget.WebSitePlus.AuthInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/auth_field</item>
        <item name="boxStrokeColor">@color/auth_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.8dp</item>
        <item name="boxStrokeErrorColor">@color/auth_error</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="startIconTint">@color/auth_brand_purple</item>
        <item name="endIconTint">@color/auth_muted</item>
        <item name="errorTextColor">@color/auth_error</item>
        <item name="hintTextColor">@color/auth_brand_purple</item>
        <item name="android:textColorHint">@color/auth_muted</item>
    </style>

    <style name="Widget.WebSitePlus.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">15.5sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@null</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">2dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Widget.WebSitePlus.Button.Biometric" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/auth_ink</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="backgroundTint">@color/auth_biometric_btn_bg</item>
        <item name="strokeColor">@color/auth_biometric_btn_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="rippleColor">@color/auth_soft_pressed</item>
        <item name="iconTint">@color/auth_brand_purple</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconGravity">top</item>
    </style>
</resources>
