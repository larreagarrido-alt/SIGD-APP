<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ranking_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/admin_bg_ranking_card_interactive"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Posición -->
        <TextView
            android:id="@+id/ranking_row_position"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="#1"
            android:textColor="@color/admin_purple_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Avatar con iniciales -->
        <TextView
            android:id="@+id/ranking_row_avatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="AM"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Nombre y cargo/área -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ranking_row_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/admin_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ranking_row_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/admin_text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Cumplimiento y puntos reales -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ranking_row_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/admin_status_delivered"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ranking_row_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/admin_status_pending"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/admin_ic_chevron_right"
            app:tint="@color/admin_text_secondary" />
    </LinearLayout>

    <!-- Variación opcional + barra fina de cumplimiento -->
    <TextView
        android:id="@+id/ranking_row_delta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:layout_marginTop="6dp"
        android:textColor="@color/admin_text_secondary"
        android:textSize="11sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/ranking_row_bar"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/admin_bg_ranking_stat_mini">

        <View
            android:id="@+id/ranking_row_bar_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/admin_bg_rewards_chip_active" />
    </FrameLayout>
</LinearLayout>
