<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/admin_bg_card"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Encabezado con semana seleccionada dinámica -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/admin_bg_wellness_stat_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/admin_ic_calendar_days"
            app:tint="@color/admin_purple_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cal_tv_selected_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Semana 47"
                android:textColor="@color/admin_text_primary"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cal_tv_selected_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="16–22 de noviembre de 2026"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/cal_btn_this_week"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/admin_bg_btn_today"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Esta semana"
            android:textColor="@color/admin_purple_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Navegación de Mes y Año -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/cal_btn_prev_month"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/admin_bg_nav_arrow_circle"
            android:contentDescription="Mes anterior"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/admin_ic_chevron_left"
            app:tint="@color/admin_text_primary" />

        <TextView
            android:id="@+id/cal_tv_month_year"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Noviembre 2026"
            android:textColor="@color/admin_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/cal_btn_next_month"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/admin_bg_nav_arrow_circle"
            android:contentDescription="Mes siguiente"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/admin_ic_chevron_right"
            app:tint="@color/admin_text_primary" />
    </LinearLayout>

    <!-- Encabezado de días de la semana (L M X J V S D) -->
    <LinearLayout
        android:id="@+id/cal_weekdays_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:weightSum="7" />

    <!-- Cuadrícula de días del mes -->
    <LinearLayout
        android:id="@+id/cal_days_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />

    <!-- Botones Cancelar y Aplicar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cal_btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/admin_bg_wellness_stat_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Cancelar"
            android:textColor="@color/admin_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cal_btn_apply"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/security_bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="Aplicar"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
