<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/podium_card_root"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/admin_bg_ranking_card_interactive"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <!-- Medalla vectorial + puesto -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/podium_medal_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/admin_ic_medal" />

        <TextView
            android:id="@+id/podium_rank_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="#1"
            android:textColor="#F2C36D"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Avatar circular con iniciales -->
    <TextView
        android:id="@+id/podium_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="9dp"
        android:gravity="center"
        android:text="AM"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Nombre -->
    <TextView
        android:id="@+id/podium_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:textColor="@color/admin_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Cumplimiento real -->
    <TextView
        android:id="@+id/podium_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/admin_status_delivered"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <!-- Puntos confirmados reales -->
    <TextView
        android:id="@+id/podium_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/admin_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
