<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/collab_bottom_nav_root"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="@drawable/collab_bg_bottom_nav"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:weightSum="5">

    <!-- 1. INICIO -->
    <LinearLayout
        android:id="@+id/collab_nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <View
            android:id="@+id/collab_nav_ind_home"
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/collab_bg_chip_selected"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/collab_nav_ic_home"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/collab_nav_home"
            android:src="@drawable/collab_ic_nav_home"
            app:tint="@color/collab_nav_active" />

        <TextView
            android:id="@+id/collab_nav_tv_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/collab_nav_home"
            android:textColor="@color/collab_nav_active"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. TEST DE BIENESTAR -->
    <LinearLayout
        android:id="@+id/collab_nav_wellness"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <View
            android:id="@+id/collab_nav_ind_wellness"
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/collab_bg_chip_selected"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/collab_nav_ic_wellness"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/collab_nav_wellness"
            android:src="@drawable/collab_ic_heart_pulse"
            app:tint="@color/collab_nav_inactive" />

        <TextView
            android:id="@+id/collab_nav_tv_wellness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/collab_nav_wellness"
            android:textColor="@color/collab_nav_inactive"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 3. KPI (Botón Central Destacado Equilibrado) -->
    <LinearLayout
        android:id="@+id/collab_nav_kpi"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="4dp">

        <View
            android:id="@+id/collab_nav_ind_kpi"
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/collab_bg_chip_selected"
            android:visibility="invisible" />

        <FrameLayout
            android:id="@+id/collab_nav_kpi_badge_box"
            android:layout_width="44dp"
            android:layout_height="30dp"
            android:background="@drawable/collab_bg_bottom_nav_kpi_center">

            <ImageView
                android:id="@+id/collab_nav_ic_kpi"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/collab_nav_kpi"
                android:src="@drawable/collab_ic_nav_kpi"
                app:tint="@android:color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/collab_nav_tv_kpi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/collab_nav_kpi"
            android:textColor="@color/collab_purple_accent"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. NOTIFICACIONES (con contador de no leídas) -->
    <LinearLayout
        android:id="@+id/collab_nav_notifs"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <View
            android:id="@+id/collab_nav_ind_notifs"
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/collab_bg_chip_selected"
            android:visibility="invisible" />

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="22dp">

            <ImageView
                android:id="@+id/collab_nav_ic_notifs"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/collab_nav_notifications"
                android:src="@drawable/collab_ic_nav_bell"
                app:tint="@color/collab_nav_inactive" />

            <TextView
                android:id="@+id/collab_nav_notif_badge"
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:layout_gravity="top|end"
                android:background="@drawable/collab_bg_chip_selected"
                android:gravity="center"
                android:minWidth="15dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:text="3"
                android:textColor="@android:color/white"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/collab_nav_tv_notifs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/collab_nav_notifications"
            android:textColor="@color/collab_nav_inactive"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 5. MENÚ -->
    <LinearLayout
        android:id="@+id/collab_nav_menu"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <View
            android:id="@+id/collab_nav_ind_menu"
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/collab_bg_chip_selected"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/collab_nav_ic_menu"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/collab_nav_menu"
            android:src="@drawable/collab_ic_nav_menu"
            app:tint="@color/collab_nav_inactive" />

        <TextView
            android:id="@+id/collab_nav_tv_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/collab_nav_menu"
            android:textColor="@color/collab_nav_inactive"
            android:textSize="10.5sp" />
    </LinearLayout>

</LinearLayout>
