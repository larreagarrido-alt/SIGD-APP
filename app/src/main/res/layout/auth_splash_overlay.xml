<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/auth_splash_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_background"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <!-- Living aurora backdrop, pulse rings and subtle 4-point sparkles -->
    <pe.net.ws.kpiweb.features.auth.SigdSplashBackdropView
        android:id="@+id/auth_splash_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Centered hero showcase -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="36dp">

        <FrameLayout
            android:id="@+id/auth_splash_logo_wrap"
            android:layout_width="196dp"
            android:layout_height="196dp"
            android:clipChildren="false">

            <!-- Breathing radial glow halo -->
            <View
                android:id="@+id/auth_splash_halo"
                android:layout_width="196dp"
                android:layout_height="196dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/auth_splash_halo" />

            <!-- Official SIGD by website logo -->
            <ImageView
                android:id="@+id/auth_splash_logo"
                android:layout_width="136dp"
                android:layout_height="146dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:contentDescription="@string/auth_logo_description"
                android:scaleType="fitCenter"
                android:src="@drawable/auth_sigd_logo_transparent" />
        </FrameLayout>

        <TextView
            android:id="@+id/auth_splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:shadowColor="#66B54BFF"
            android:shadowDy="2"
            android:shadowRadius="12"
            android:text="@string/auth_hero_title"
            android:textColor="@android:color/white"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/auth_splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0"
            android:gravity="center"
            android:text="@string/auth_hero_subtitle"
            android:textColor="@color/auth_light_text"
            android:textSize="13.5sp" />

        <!-- Minimal glowing progress beam -->
        <FrameLayout
            android:id="@+id/auth_splash_loader_track"
            android:layout_width="124dp"
            android:layout_height="3.5dp"
            android:layout_marginTop="28dp"
            android:alpha="0"
            android:background="@drawable/auth_splash_loader_track"
            android:clipChildren="true"
            android:clipToPadding="true">

            <View
                android:id="@+id/auth_splash_loader_beam"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:background="@drawable/auth_splash_loader_beam" />
        </FrameLayout>
    </LinearLayout>

    <!-- Subtle corporate footer -->
    <TextView
        android:id="@+id/auth_splash_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="26dp"
        android:alpha="0"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:text="SISTEMA INTEGRAL DE GESTIÓN DEL DESEMPEÑO"
        android:textColor="#A8DFC8FA"
        android:textSize="10.5sp"
        android:textStyle="bold" />
</FrameLayout>
