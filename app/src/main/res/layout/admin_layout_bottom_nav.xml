<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/admin_bottom_nav_container"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="@drawable/admin_bg_bottom_nav"
    android:baselineAligned="false"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:weightSum="5">

    <!-- 1. PERSONAL -->
    <LinearLayout
        android:id="@+id/admin_nav_tab_staff"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        tools:ignore="TouchTargetSizeCheck">

        <View
            android:id="@+id/admin_nav_ind_staff"
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/admin_bg_nav_indicator"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/admin_nav_ic_staff"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/admin_nav_personal"
            android:src="@drawable/admin_ic_dash_users"
            app:tint="@color/admin_dash_nav_inactive" />

        <TextView
            android:id="@+id/admin_nav_tv_staff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/admin_nav_personal"
            android:textColor="@color/admin_dash_nav_inactive"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- 2. REPORTES -->
    <LinearLayout
        android:id="@+id/admin_nav_tab_reports"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        tools:ignore="TouchTargetSizeCheck">

        <View
            android:id="@+id/admin_nav_ind_reports"
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/admin_bg_nav_indicator"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/admin_nav_ic_reports"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/admin_nav_reports"
            android:src="@drawable/collab_ic_nav_kpi"
            app:tint="@color/admin_dash_nav_inactive" />

        <TextView
            android:id="@+id/admin_nav_tv_reports"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/admin_nav_reports"
            android:textColor="@color/admin_dash_nav_inactive"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- 3. INICIO (Botón Central Destacado unificado con el Colaborador) -->
    <LinearLayout
        android:id="@+id/admin_nav_tab_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        tools:ignore="TouchTargetSizeCheck">

        <View
            android:id="@+id/admin_nav_ind_home"
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/admin_bg_nav_indicator"
            android:visibility="visible" />

        <FrameLayout
            android:id="@+id/admin_nav_home_badge_box"
            android:layout_width="44dp"
            android:layout_height="30dp"
            android:background="@drawable/admin_bg_nav_center_pill">

            <ImageView
                android:id="@+id/admin_nav_ic_home"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/admin_nav_home"
                android:src="@drawable/collab_ic_nav_home"
                app:tint="@android:color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/admin_nav_tv_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/admin_nav_home"
            android:textColor="@color/admin_dash_nav_active"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. NOTIFICACIONES -->
    <LinearLayout
        android:id="@+id/admin_nav_tab_notifs"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        tools:ignore="TouchTargetSizeCheck">

        <View
            android:id="@+id/admin_nav_ind_notifs"
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/admin_bg_nav_indicator"
            android:visibility="invisible" />

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="22dp">

            <ImageView
                android:id="@+id/admin_nav_ic_notifs"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/admin_nav_notifications"
                android:src="@drawable/collab_ic_nav_bell"
                app:tint="@color/admin_dash_nav_inactive" />

            <View
                android:id="@+id/admin_nav_badge_notifs"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/admin_bg_nav_badge_dot"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/admin_nav_tv_notifs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/admin_nav_notifications"
            android:textColor="@color/admin_dash_nav_inactive"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 5. MENÚ -->
    <LinearLayout
        android:id="@+id/admin_nav_tab_menu"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        tools:ignore="TouchTargetSizeCheck">

        <View
            android:id="@+id/admin_nav_ind_menu"
            android:layout_width="20dp"
            android:layout_height="3dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/admin_bg_nav_indicator"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/admin_nav_ic_menu"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/admin_nav_menu"
            android:src="@drawable/collab_ic_nav_menu"
            app:tint="@color/admin_dash_nav_inactive" />

        <TextView
            android:id="@+id/admin_nav_tv_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/admin_nav_menu"
            android:textColor="@color/admin_dash_nav_inactive"
            android:textSize="10.5sp" />
    </LinearLayout>

</LinearLayout>
