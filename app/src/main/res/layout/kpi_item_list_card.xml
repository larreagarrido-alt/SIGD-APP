<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/kpi_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/kpi_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Barra superior de acento degradado -->
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/kpi_bg_gradient_btn" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="Fecha"
                        android:src="@drawable/kpi_ic_calendar"
                        app:tint="@color/kpi_primary" />

                    <TextView
                        android:id="@+id/tvListCardDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24 / 05 / 2025"
                        android:textColor="@color/kpi_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Badge de Productividad -->
                <TextView
                    android:id="@+id/tvListCardProductivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/kpi_bg_pill_status"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="EXCELENTE (100%)"
                    android:textColor="@color/kpi_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Practicante y Turno -->
            <TextView
                android:id="@+id/tvListCardPracticante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Colaborador"
                android:textColor="@color/kpi_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvListCardTurno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:text="Turno: Mañana (8:00 am - 1:30 pm)"
                android:textColor="@color/kpi_text_secondary"
                android:textSize="12sp" />

            <!-- Métricas resumidas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/kpi_bg_commit_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvListCardActivitiesCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="5 Actividades (5 Entregadas)"
                    android:textColor="@color/kpi_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvListCardBugsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 Bug detectado"
                    android:textColor="@color/kpi_warning"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
