<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/kpi_bg_dialog_celebration"
    android:elevation="12dp"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="26dp">

    <!-- Ícono Trofeo de Celebración -->
    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/kpi_bg_circle_icon_light"
        android:padding="16dp"
        android:src="@drawable/kpi_ic_trophy"
        app:tint="#5B46D6" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:text="¡Semana completada!"
        android:textColor="#0F172A"
        android:textSize="21sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="Registraste los 6 días (lunes a sábado). Tu resumen semanal completo ya está desbloqueado."
        android:textColor="#64748B"
        android:textSize="13sp" />

    <!-- 3 Mini Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/kpi_bg_day_tab_locked"
            android:gravity="center"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="6/6"
                android:textColor="#5B46D6"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="DÍAS"
                android:textColor="#857BA8"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/kpi_bg_day_tab_locked"
            android:gravity="center"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvCelebrationPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="100%"
                android:textColor="#10B981"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="META"
                android:textColor="#857BA8"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/kpi_bg_day_tab_locked"
            android:gravity="center"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Listo"
                android:textColor="#0284C7"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="ESTADO"
                android:textColor="#857BA8"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botón Ver Resumen -->
    <Button
        android:id="@+id/btnCelebrationViewSummary"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/kpi_bg_gradient_btn"
        android:elevation="2dp"
        android:fontFamily="sans-serif-black"
        android:text="Ver resumen semanal"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <!-- Botón Seguir Editando -->
    <Button
        android:id="@+id/btnCelebrationKeepEditing"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/kpi_bg_day_tab_locked"
        app:backgroundTint="@null"
        android:textStyle="bold"
        android:text="Seguir editando mis metas"
        android:textAllCaps="false"
        android:textColor="#5B46D6"
        android:textSize="13sp" />

</LinearLayout>
