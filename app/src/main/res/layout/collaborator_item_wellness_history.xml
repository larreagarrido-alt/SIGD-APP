<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="horizontal">

    <!-- Columna de línea de tiempo vertical -->
    <LinearLayout
        android:layout_width="22dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:id="@+id/wellness_hist_dot"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/collab_bg_level_node_done" />

        <View
            android:id="@+id/wellness_hist_line"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="@color/collab_prog_border_subtle" />
    </LinearLayout>

    <!-- Tarjeta compacta del registro real -->
    <LinearLayout
        android:id="@+id/wellness_hist_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:background="@drawable/collab_bg_notif_card_read"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/collab_bg_icon_badge_purple">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="Período"
                android:src="@drawable/admin_ic_calendar"
                app:tint="@color/collab_notif_violet_soft" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/wellness_hist_tv_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Evaluación mensual"
                    android:textColor="@color/collab_text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wellness_hist_tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/collab_bg_notif_status_positive"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="Completada"
                    android:textColor="@color/collab_notif_positive"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/wellness_hist_tv_period"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Noviembre 2026"
                android:textColor="@color/collab_prog_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/wellness_hist_tv_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/collab_text_muted"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/wellness_hist_chevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Consultar detalle"
            android:src="@drawable/admin_ic_chevron_right"
            app:tint="@color/collab_prog_text_secondary" />
    </LinearLayout>
</LinearLayout>
