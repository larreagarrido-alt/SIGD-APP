<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/face_enroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_bg_main"
    android:orientation="vertical">

    <!-- 1. ENCABEZADO VISUAL INTEGRADO CON LOGO OFICIAL SIGD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/admin_bg_header_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <FrameLayout
            android:id="@+id/enroll_btn_back_top"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/security_bg_back_btn"
            android:clickable="true"
            android:contentDescription="Regresar"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/admin_ic_chevron_left"
                app:tint="@color/admin_text_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/security_ic_scan_face"
                    app:tint="@color/admin_purple_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="@string/auth_face_security"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/personal_ic_user_round_check"
                    app:tint="@color/sigd_sec_mint" />

                <TextView
                    android:id="@+id/face_enroll_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Logo oficial SIGD transparente con contraste automático en modo claro -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/sigd_bg_brand_logo_contrast"
            android:paddingStart="7dp"
            android:paddingTop="5dp"
            android:paddingEnd="7dp"
            android:paddingBottom="5dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="46dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/auth_logo_description"
                android:scaleType="fitCenter"
                android:src="@drawable/auth_sigd_logo_transparent" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/admin_border" />

    <!-- 2. CONTENIDO SCROLLABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <!-- CÁMARA EN VIVO (SOLO VISIBLE DURANTE LA CAPTURA) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/enroll_camera_card"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="#1B0E2C"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/admin_purple_primary"
                app:strokeWidth="1.5dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#11091F">

                    <TextureView
                        android:id="@+id/enroll_camera"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <WebView
                        android:id="@+id/enroll_engine"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:importantForAccessibility="noHideDescendants" />

                    <pe.net.ws.kpiweb.features.auth.FaceOverlayView
                        android:id="@+id/enroll_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA PRINCIPAL PREMIUM: ESTADO Y ACCIONES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/security_bg_card_hero"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/enroll_hero_badge"
                        android:layout_width="46dp"
                        android:layout_height="46dp">

                        <ImageView
                            android:id="@+id/enroll_hero_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/security_ic_scan_face"
                            app:tint="@color/admin_purple_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/enroll_status_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Validación facial"
                            android:textColor="@color/admin_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Protección biométrica del dispositivo"
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/enroll_state_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="Verificando"
                        android:textColor="@color/admin_purple_accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/security_bg_card_surface"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/enroll_status_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/security_ic_shield_check"
                        app:tint="@color/admin_purple_accent" />

                    <TextView
                        android:id="@+id/enroll_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/auth_face_enroll_checking"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/admin_border" />

                <!-- BOTÓN PRINCIPAL -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/enroll_start"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="52dp"
                    android:text="@string/auth_face_enroll_title"
                    android:textAllCaps="false"
                    android:textColor="@color/face_btn_primary_text"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/face_btn_primary_bg"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/security_ic_scan_face"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="19dp"
                    app:iconTint="@color/face_btn_primary_text" />

                <!-- BOTÓN SECUNDARIO -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/face_prepare_key"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="50dp"
                    android:text="@string/auth_face_prepare_key"
                    android:textAllCaps="false"
                    android:textColor="@color/face_btn_secondary_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/face_btn_secondary_bg"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/security_ic_shield_check"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/face_btn_secondary_text"
                    app:strokeColor="@color/face_btn_secondary_stroke"
                    app:strokeWidth="1.2dp" />

                <!-- ACCIÓN DE DESACTIVAR -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/face_disable"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="48dp"
                    android:text="@string/auth_face_disable"
                    android:textAllCaps="false"
                    android:textColor="@color/sigd_sec_coral"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="@color/sigd_sec_crit_bg"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/collab_ic_lock"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="17dp"
                    app:iconTint="@color/sigd_sec_coral"
                    app:strokeColor="@color/sigd_sec_coral"
                    app:strokeWidth="1.2dp" />

                <!-- BOTÓN TERCIARIO DISCRETO -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/enroll_back"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="44dp"
                    android:text="@string/auth_face_enroll_back"
                    android:textAllCaps="false"
                    android:textColor="@color/admin_purple_accent"
                    android:textSize="13.5sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/admin_ic_chevron_left"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/admin_purple_accent" />
            </LinearLayout>

            <!-- TARJETA INFORMATIVA VISUAL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.08"
                android:text="REQUISITOS Y SEGURIDAD"
                android:textColor="@color/admin_text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/security_bg_info_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/face_enroll_explanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/auth_face_enroll_explanation"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="12.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/admin_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/enroll_req_badge_phone"
                        android:layout_width="34dp"
                        android:layout_height="34dp">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/security_ic_smartphone"
                            app:tint="@color/admin_purple_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dispositivo vinculado"
                            android:textColor="@color/admin_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Ingresa desde el celular vinculado a tu cuenta para gestionar tu rostro."
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/enroll_req_badge_fp"
                        android:layout_width="34dp"
                        android:layout_height="34dp">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/security_ic_fingerprint"
                            app:tint="@color/sigd_sec_mint" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Acceso biométrico previo"
                            android:textColor="@color/admin_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Activa primero la biometría segura del equipo para autorizar cambios."
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/enroll_req_badge_lock"
                        android:layout_width="34dp"
                        android:layout_height="34dp">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/collab_ic_lock"
                            app:tint="@color/admin_purple_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Validación controlada"
                            android:textColor="@color/admin_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="El ingreso facial permanece deshabilitado hasta completar la configuración requerida."
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
