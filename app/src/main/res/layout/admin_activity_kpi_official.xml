<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/kpi_official_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_bg_main"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/kpi_official_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <!-- 1. ENCABEZADO DEL MÓDULO -->
        <LinearLayout
            android:id="@+id/kpi_official_header_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/admin_bg_kpi_module_header"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <FrameLayout
                android:id="@+id/kpi_official_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/admin_bg_circle_icon_button"
                android:clickable="true"
                android:contentDescription="Volver"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/admin_ic_chevron_left"
                    app:tint="@color/admin_text_primary" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="9dp"
                android:background="@drawable/admin_bg_icon_badge_purple">
                <ImageView
                    android:id="@+id/kpi_official_header_icon"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/admin_ic_target"
                    app:tint="@color/admin_purple_accent" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/kpi_official_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Gestión KPI oficial"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/kpi_official_header_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Indicadores, revisión y cierre mensual"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/kpi_official_refresh"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/admin_bg_circle_icon_button"
                android:clickable="true"
                android:contentDescription="Actualizar datos"
                android:focusable="true">

                <ImageView
                    android:id="@+id/kpi_official_refresh_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/admin_ic_refresh"
                    app:tint="@color/admin_purple_accent" />
            </FrameLayout>
        </LinearLayout>

        <!-- 2. TARJETA DE ESTADO DEL PERÍODO -->
        <LinearLayout
            android:id="@+id/kpi_period_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/admin_bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="13dp"
            android:paddingEnd="14dp"
            android:paddingBottom="13dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/admin_bg_icon_badge_purple">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/admin_ic_calendar"
                        app:tint="@color/admin_purple_accent" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Estado del período"
                        android:textColor="@color/admin_text_muted"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/kpi_period_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Cargando…"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/kpi_period_loading"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/admin_purple_accent" />

                <TextView
                    android:id="@+id/kpi_period_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/admin_bg_ranking_mini_chip"
                    android:maxLines="1"
                    android:paddingStart="9dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/admin_purple_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/kpi_period_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingMultiplier="1.15"
                android:text="Consultando información del servidor…"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Aviso discreto de resultado de operaciones administrativas / errores -->
        <LinearLayout
            android:id="@+id/kpi_feedback_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/admin_bg_ranking_filter_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/admin_ic_info_circle"
                app:tint="@color/admin_purple_accent" />

            <TextView
                android:id="@+id/kpi_feedback_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/admin_text_primary"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/kpi_feedback_dismiss"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:clickable="true"
                android:contentDescription="Cerrar aviso"
                android:focusable="true">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/admin_ic_close"
                    app:tint="@color/admin_text_muted" />
            </FrameLayout>
        </LinearLayout>

        <!-- 3. SECCIÓN: ADMINISTRACIÓN DE INDICADORES -->
        <TextView
            android:id="@+id/kpi_admin_section_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Administración de indicadores"
            android:textColor="@color/admin_text_primary"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/kpi_admin_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Tarjeta 1: Configurar indicadores -->
            <LinearLayout
                android:id="@+id/kpi_card_configure"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/admin_bg_ranking_period_card"
                android:clickable="true"
                android:contentDescription="Configurar indicadores. Definir y administrar KPI"
                android:elevation="1dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/admin_bg_icon_badge_purple">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/admin_ic_sliders"
                        app:tint="@color/admin_purple_accent" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Configurar indicadores"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Definir y administrar KPI"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Tarjeta 2: Fichas por trabajador -->
            <LinearLayout
                android:id="@+id/kpi_card_worker_sheets"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/admin_bg_ranking_period_card"
                android:clickable="true"
                android:contentDescription="Fichas por trabajador. Consultar evaluaciones"
                android:elevation="1dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/admin_bg_icon_badge_purple">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/admin_ic_clipboard"
                        app:tint="@color/admin_purple_accent" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Fichas por trabajador"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Consultar evaluaciones"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Aviso discreto cuando no hay indicadores oficiales configurados -->
        <LinearLayout
            android:id="@+id/kpi_definitions_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/admin_bg_ranking_filter_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/admin_ic_info_circle"
                app:tint="@color/admin_text_muted" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Aún no hay indicadores oficiales configurados."
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Listado de indicadores oficiales configurados -->
        <LinearLayout
            android:id="@+id/kpi_definitions_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical" />

        <!-- 4. SECCIÓN: REPORTES PARA REVISIÓN -->
        <LinearLayout
            android:id="@+id/kpi_reports_section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/kpi_reports_section_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Reportes para revisión"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Consulta y seguimiento de evaluaciones"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/kpi_reports_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/admin_bg_ranking_mini_chip"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="0"
                android:textColor="@color/admin_purple_accent"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Barra de búsqueda local de reportes -->
        <LinearLayout
            android:id="@+id/kpi_reports_search_container"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/admin_bg_ranking_search"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/kpi_reports_search_icon"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/admin_ic_search"
                app:tint="@color/admin_text_muted" />

            <EditText
                android:id="@+id/kpi_reports_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Buscar reporte o trabajador..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/admin_text_primary"
                android:textColorHint="@color/admin_text_muted"
                android:textSize="13.5sp" />

            <FrameLayout
                android:id="@+id/kpi_reports_search_clear"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/admin_bg_circle_icon_button"
                android:clickable="true"
                android:contentDescription="Limpiar búsqueda de reportes"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/admin_ic_close"
                    app:tint="@color/admin_text_primary" />
            </FrameLayout>
        </LinearLayout>

        <!-- Estado vacío elegante de reportes -->
        <LinearLayout
            android:id="@+id/kpi_reports_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/admin_bg_ranking_filter_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/admin_bg_icon_badge_purple">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/admin_ic_file_chart"
                    app:tint="@color/admin_purple_accent" />
            </FrameLayout>

            <TextView
                android:id="@+id/kpi_reports_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Sin reportes disponibles"
                android:textColor="@color/admin_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/kpi_reports_empty_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="No hay formularios recibidos para revisar."
                android:textColor="@color/admin_text_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Lista de reportes -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/kpi_reports_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <LinearLayout
            android:id="@+id/kpi_reports_toggle_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/admin_bg_ranking_clear_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/kpi_reports_toggle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver todos los reportes"
                android:textColor="@color/admin_purple_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/kpi_reports_toggle_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/admin_ic_chevron_down"
                app:tint="@color/admin_purple_accent" />
        </LinearLayout>

        <!-- 5. SECCIÓN: CIERRE Y APROBACIÓN -->
        <LinearLayout
            android:id="@+id/kpi_closure_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cierre y aprobación"
                android:textColor="@color/admin_text_primary"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Control y validación del período de evaluación"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/kpi_action_approve_policy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/admin_bg_ranking_period_card"
            android:clickable="true"
            android:contentDescription="Reglas de comparación. Revisar y aprobar criterios entre cargos"
            android:elevation="1dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="76dp"
            android:orientation="horizontal"
            android:padding="14dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/admin_bg_icon_badge_purple">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/admin_ic_shield_check"
                    app:tint="@color/admin_purple_accent" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Reglas de comparación"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Revisar y aprobar criterios entre cargos"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/admin_ic_chevron_right"
                app:tint="@color/admin_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/kpi_action_close_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/admin_bg_kpi_close_card"
            android:clickable="true"
            android:contentDescription="Cierre mensual. Validar y finalizar el período aprobado"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="80dp"
            android:orientation="horizontal"
            android:padding="14dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/admin_bg_kpi_icon_featured">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/admin_ic_calendar_check_2"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Cierre mensual"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/kpi_close_card_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/admin_bg_ranking_mini_chip"
                        android:maxLines="1"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:textColor="@color/admin_status_delivered"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Validar y finalizar el período aprobado"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/admin_ic_chevron_right"
                app:tint="@color/admin_purple_accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/kpi_closure_info_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/admin_bg_ranking_filter_panel"
            android:gravity="top"
            android:orientation="horizontal"
            android:padding="13dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:src="@drawable/admin_ic_info_circle"
                app:tint="@color/admin_purple_accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.2"
                android:text="Los formularios enviados no generan puntos ni ranking hasta que sus evaluaciones sean aprobadas y el mes quede cerrado."
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
