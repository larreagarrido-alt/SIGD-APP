<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/personal_bg_card_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Fila 1: Título del KPI y Badge de Estado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_kpi_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Disponibilidad del Core"
            android:textColor="@color/personal_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_kpi_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/personal_bg_status_active"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="Cumplido"
            android:textColor="@color/personal_status_delivered"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Fila 2: Descripción del KPI -->
    <TextView
        android:id="@+id/tv_kpi_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Uptime de microservicios críticos en producción"
        android:textColor="@color/personal_text_secondary"
        android:textSize="12sp" />

    <!-- Fila 3: Tipo de Medición, Meta y Obtenido -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Tipo de medición -->
        <TextView
            android:id="@+id/tv_kpi_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/personal_bg_period_capsule"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="Porcentaje"
            android:textColor="@color/personal_purple_accent"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Meta -->
        <TextView
            android:id="@+id/tv_kpi_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="Meta: 99.5%"
            android:textColor="@color/personal_text_muted"
            android:textSize="12sp" />

        <!-- Valor Actual -->
        <TextView
            android:id="@+id/tv_kpi_actual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="99.9%"
            android:textColor="@color/personal_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Barra de progreso visual (cuando corresponda) -->
    <ProgressBar
        android:id="@+id/pb_kpi_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="100"
        android:progressDrawable="@drawable/personal_progress_horizontal" />
</LinearLayout>
