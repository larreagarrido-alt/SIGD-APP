<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/collab_bg_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Encabezado Adaptable -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/collab_bg_header_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/admin_space_lg"
        android:paddingTop="@dimen/admin_space_md"
        android:paddingEnd="@dimen/admin_space_lg"
        android:paddingBottom="@dimen/admin_space_md">

        <!-- Botón Cerrar -->
        <FrameLayout
            android:id="@+id/account_edit_btn_close"
            android:layout_width="@dimen/admin_icon_btn_size"
            android:layout_height="@dimen/admin_icon_btn_size"
            android:background="@drawable/collab_bg_circle_button"
            android:clickable="true"
            android:contentDescription="Cerrar"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/admin_ic_close"
                app:tint="@color/collab_text_primary" />
        </FrameLayout>

        <!-- Título y Subtítulo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_edit_title"
                android:textColor="@color/collab_text_primary"
                android:textSize="@dimen/admin_text_xl"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/account_edit_sub"
                android:textColor="@color/collab_text_secondary"
                android:textSize="@dimen/admin_text_xs" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/collab_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/admin_space_lg">

            <!-- Banner Informativo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/collab_bg_card_hero"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/account_ic_edit"
                    app:tint="@color/collab_purple_accent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/account_edit_disclaimer"
                    android:textColor="@color/collab_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/collab_bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Campo 1: Nombre Completo (Editable) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre para mostrar *"
                    android:textColor="@color/collab_text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/account_edit_layout_name"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:boxBackgroundColor="@color/collab_bg_input"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/collab_purple_primary"
                    app:errorEnabled="true"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/account_edit_et_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ej. Lucía Gómez"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:textColor="@color/collab_text_primary"
                        android:textColorHint="@color/collab_text_muted"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo 2: Teléfono Móvil (Editable) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Teléfono móvil de contacto *"
                    android:textColor="@color/collab_text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/account_edit_layout_phone"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:boxBackgroundColor="@color/collab_bg_input"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/collab_purple_primary"
                    app:errorEnabled="true"
                    app:helperText="Formato requerido: 9 dígitos (ej. 987654321)"
                    app:helperTextTextColor="@color/collab_text_secondary"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/account_edit_et_phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ingresa tu número móvil"
                        android:inputType="phone"
                        android:maxLength="12"
                        android:maxLines="1"
                        android:textColor="@color/collab_text_primary"
                        android:textColorHint="@color/collab_text_muted"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo 3: Correo (Solo Lectura) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Correo institucional (Solo lectura)"
                    android:textColor="@color/collab_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:enabled="false"
                    app:boxBackgroundColor="@color/collab_bg_surface_secondary"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/collab_border"
                    app:helperText="El correo institucional es administrado por el área de TI"
                    app:helperTextTextColor="@color/collab_text_muted"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/account_edit_et_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/collab_text_secondary"
                        android:textSize="14.5sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo 4: Cargo y Departamento (Solo Lectura) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cargo y Departamento (Solo lectura)"
                    android:textColor="@color/collab_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:enabled="false"
                    app:boxBackgroundColor="@color/collab_bg_surface_secondary"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/collab_border"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/account_edit_et_job"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/collab_text_secondary"
                        android:textSize="14.5sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Barra de progreso durante guardado -->
            <ProgressBar
                android:id="@+id/account_edit_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- Botón Guardar Cambios -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/account_edit_btn_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/collab_purple_primary"
                android:letterSpacing="0.03"
                android:text="@string/account_edit_save"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/account_ic_check"
                app:iconGravity="textStart"
                app:iconTint="@android:color/white" />

            <!-- Botón Cancelar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/account_edit_btn_cancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:letterSpacing="0.03"
                android:text="@string/account_edit_cancel"
                android:textAllCaps="false"
                android:textColor="@color/collab_text_primary"
                android:textSize="14.5sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/collab_border" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
