<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/collab_bg_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ENCABEZADO ADAPTATIVO CON LOGO ORIGINAL DE WEBSITE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/collab_bg_header_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/collab_assistant_btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/collab_bg_circle_button"
            android:clickable="true"
            android:contentDescription="Volver"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/admin_ic_chevron_left"
                app:tint="@color/collab_text_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Asistente de bienestar"
                android:textColor="@color/collab_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Tu espacio de orientación"
                android:textColor="@color/collab_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Logo original de Website (transparente, proporciones originales, morado en claro / blanco en oscuro) -->
        <ImageView
            android:id="@+id/collab_assistant_header_logo"
            android:layout_width="78dp"
            android:layout_height="26dp"
            android:adjustViewBounds="true"
            android:contentDescription="Website"
            android:scaleType="fitCenter"
            android:src="@drawable/collab_img_website_logo" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/collab_divider" />

    <!-- CHAT DESPLAZABLE -->
    <ScrollView
        android:id="@+id/collab_assistant_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/collab_assistant_messages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.07"
                android:text="PREGUNTAS FRECUENTES"
                android:textColor="@color/collab_purple_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/collab_assistant_suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/collab_divider" />

    <!-- RESPONSABILIDAD + CAMPO DE ESCRITURA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/collab_bg_surface"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="Este asistente proporciona orientación general y no sustituye la atención de un profesional."
            android:textColor="@color/collab_text_muted"
            android:textSize="10.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/collab_assistant_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/admin_bg_wellness_input"
                android:hint="Escribe tu consulta de bienestar laboral..."
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="44dp"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:textColor="@color/collab_text_primary"
                android:textColorHint="@color/collab_text_muted"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/collab_assistant_btn_send"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/admin_bg_wellness_primary_btn"
                android:clickable="true"
                android:contentDescription="Enviar"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/collab_ic_send"
                    app:tint="@android:color/white" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
