<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/collab_bg_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 1. ENCABEZADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/collab_bg_header_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/admin_space_lg"
        android:paddingTop="@dimen/admin_space_md"
        android:paddingEnd="@dimen/admin_space_lg"
        android:paddingBottom="@dimen/admin_space_md">

        <FrameLayout
            android:id="@+id/collab_privacy_btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/collab_bg_circle_button"
            android:clickable="true"
            android:contentDescription="Volver"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/admin_ic_chevron_left"
                app:tint="@color/collab_text_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Privacidad y permisos"
                android:textColor="@color/collab_text_primary"
                android:textSize="@dimen/admin_text_xl"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Control de permisos, datos locales e historial"
                android:textColor="@color/collab_text_secondary"
                android:textSize="@dimen/admin_text_xs" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. CONTENIDO SCROLLABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/admin_space_lg">

            <!-- SECCIÓN 1: PERMISOS DEL DISPOSITIVO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/admin_space_sm"
                android:letterSpacing="0.08"
                android:text="PERMISOS QUE UTILIZA WEBSITE"
                android:textColor="@color/collab_text_secondary"
                android:textSize="@dimen/admin_text_xs"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/collab_bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Permiso 1: Notificaciones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/collab_bg_icon_badge_purple">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/collab_ic_nav_bell"
                            app:tint="@color/collab_purple_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Notificaciones (POST_NOTIFICATIONS)"
                            android:textColor="@color/collab_text_primary"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Permite mostrar recordatorios locales de entregas de KPI y avisos generales."
                            android:textColor="@color/collab_text_secondary"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/collab_privacy_tv_notif_perm_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/collab_bg_pill_green"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="Activo"
                        android:textColor="@color/collab_status_completed"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/collab_divider" />

                <!-- Permiso 2: Red / Internet (Para futura conexión a servidor PHP) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/collab_bg_icon_badge_cyan">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/collab_ic_privacy_shield"
                            app:tint="@color/collab_cyan_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Conexión segura a red corporativa"
                            android:textColor="@color/collab_text_primary"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Se utilizará únicamente para sincronizar KPI y consultar la API propia en PHP."
                            android:textColor="@color/collab_text_secondary"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/collab_bg_pill_purple"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="Estándar"
                        android:textColor="@color/collab_purple_accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Botón Abrir Configuración de Permisos del Sistema -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/collab_privacy_btn_system_settings"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/collab_purple_primary"
                    android:text="Abrir permisos del sistema Android"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- SECCIÓN 2: ALMACENAMIENTO LOCAL DE PREFERENCIAS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_space_xl"
                android:layout_marginBottom="@dimen/admin_space_sm"
                android:letterSpacing="0.08"
                android:text="ALMACENAMIENTO LOCAL Y SEGURIDAD"
                android:textColor="@color/collab_text_secondary"
                android:textSize="@dimen/admin_text_xs"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/collab_bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¿Qué guarda WEBSITE en tu dispositivo?"
                    android:textColor="@color/collab_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="• Preferencia de apariencia (Modo claro, Modo oscuro o Sistema).\n• Estado de interruptores de recordatorios de KPI y avisos.\n• Estado de lectura de notificaciones de prueba.\n• WEBSITE no debe almacenar contraseñas en texto plano en el dispositivo."
                    android:textColor="@color/collab_text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- SECCIÓN 4: POLÍTICA DE PRIVACIDAD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_space_xl"
                android:layout_marginBottom="@dimen/admin_space_sm"
                android:letterSpacing="0.08"
                android:text="DOCUMENTACIÓN NORMATIVA"
                android:textColor="@color/collab_text_secondary"
                android:textSize="@dimen/admin_text_xs"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/collab_privacy_btn_policy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/collab_bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/collab_bg_icon_badge_purple">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/collab_ic_info_circle"
                        app:tint="@color/collab_purple_accent" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Política de Privacidad institucional"
                        android:textColor="@color/collab_text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Estado: Documento oficial pendiente de publicación"
                        android:textColor="@color/collab_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/admin_ic_chevron_right"
                    app:tint="@color/collab_purple_accent" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
