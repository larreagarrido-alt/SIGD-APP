<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llJuniorSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="HardcodedText,SmallSp">

    <!-- ========================================================================= -->
    <!-- CABECERA OFICIAL: PRACTICANTE JUNIOR (SIGD 2026)                          -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIGD"
                android:textColor="#1E1B4B"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="Agencia &amp; Software"
                android:textColor="#64748B"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOJA OFICIAL DE EVALUACIÓN SEMANAL"
                android:textColor="#1E1B4B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSheetJrRoleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRACTICANTE JUNIOR — CONTROL DE DOBLE TURNO (SIGD 2026)"
                android:textColor="#4F46E5"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sincronizado con Asistencia en Base de Datos MySQL"
                android:textColor="#64748B"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/kpi_bg_card_white"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEMANA"
                android:textColor="#64748B"
                android:textSize="7.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSheetJrWeekNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="37"
                android:textColor="#1E1B4B"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="#E2E8F0" />

    <!-- ========================================================================= -->
    <!-- FICHA DE DATOS DEL PRACTICANTE                                            -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F8FAFC"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSheetJrCollabName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Practicante:  JUAN PÉREZ · JUNIOR"
                android:textColor="#1E293B"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSheetJrCollabRole"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cargo:  PROGRAMADOR JUNIOR"
                android:textColor="#1E293B"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSheetJrCollabShift"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Horarios:  Mañana (08:00 - 13:30) / Tarde (14:00 - 18:40)"
                android:textColor="#475569"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/tvSheetJrCollabSupervisor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Evaluador:  LIC. MANUEL CASTILLO (DIRECCIÓN)"
                android:textColor="#475569"
                android:textSize="9.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========================================================================= -->
    <!-- RESUMEN EJECUTIVO DE RENDIMIENTO SEMANAL (BADGES)                          -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#EFF6FF"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TURNOS ASISTIDOS (BD)"
                android:textColor="#1D4ED8"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSheetJrAttendedShifts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 / 12 turnos"
                android:textColor="#1E3A8A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="#F0FDF4"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL ACTIVIDADES / PIEZAS"
                android:textColor="#15803D"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSheetJrDeliveredTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="28 entregadas"
                android:textColor="#14532D"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="#FEF3C7"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUMPLIMIENTO SEMANAL"
                android:textColor="#B45309"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSheetJrWeeklyPct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="94.5%"
                android:textColor="#78350F"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="#F5F3FF"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTA FINAL PRACTICANTE"
                android:textColor="#6D28D9"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSheetJrFinalScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18.8 / 20"
                android:textColor="#4C1D95"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========================================================================= -->
    <!-- TABLA DETALLADA LUNES A SÁBADO: TURNO MAÑANA Y TURNO TARDE                -->
    <!-- ========================================================================= -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:text="CONTROL DIARIO DE ASISTENCIA Y KPI POR TURNOS (LUNES A SÁBADO)"
        android:textColor="#1E1B4B"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- Encabezado de la tabla -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#312E81"
        android:orientation="horizontal"
        android:paddingVertical="5dp"
        android:paddingHorizontal="4dp">

        <TextView
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:text="DÍA"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="ASISTENCIA BD"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TURNO MAÑANA (08:00 - 13:30)"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TURNO TARDE (14:00 - 18:40)"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="CALIF."
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Contenedor dinámico de filas Lunes a Sábado -->
    <LinearLayout
        android:id="@+id/llJuniorDaysTable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- ========================================================================= -->
    <!-- OBSERVACIONES DE EVALUACIÓN Y FIRMAS OFICIALES                             -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#F8FAFC"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OBSERVACIONES DE LA SUPERVISIÓN (LIC. MANUEL CASTILLO):"
            android:textColor="#334155"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSheetJrObservations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Desempeño técnico sobresaliente durante los turnos registrados. Entregables puntuales y debidamente sellados mediante autenticación biométrica nativa."
            android:textColor="#475569"
            android:textSize="8.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Firma Practicante -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <View
                android:layout_width="140dp"
                android:layout_height="1dp"
                android:background="#334155" />

            <TextView
                android:id="@+id/tvSheetJrSignaturePracticante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Firma del Practicante Junior"
                android:textColor="#1E293B"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verificación Biométrica ✓"
                android:textColor="#16A34A"
                android:textSize="7.5sp" />
        </LinearLayout>

        <!-- Firma Supervisor -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <View
                android:layout_width="140dp"
                android:layout_height="1dp"
                android:background="#334155" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Lic. Manuel Castillo"
                android:textColor="#1E293B"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dirección de Evaluación y Prácticas"
                android:textColor="#475569"
                android:textSize="7.5sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Documento Oficial SIGD · WebSite+ © 2026 · Emitido conforme a la base de datos empresarial"
        android:textColor="#94A3B8"
        android:textSize="7sp" />
</LinearLayout>
