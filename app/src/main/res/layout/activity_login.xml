<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/auth_login_background"
    tools:context=".features.auth.LoginActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/login_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.46"
                app:layout_constraintWidth_max="430dp">

                <!-- 1. LOGO SIGD CENTRADO Y SIN FONDO CUADRADO -->
                <ImageView
                    android:id="@+id/iv_auth_logo"
                    android:layout_width="112dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center_horizontal"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/auth_logo_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/auth_sigd_logo_transparent" />

                <!-- 2. ENCABEZADO DE BIENVENIDA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:breakStrategy="balanced"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/auth_hero_title"
                    android:textColor="@android:color/white"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:breakStrategy="balanced"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/auth_hero_subtitle"
                    android:textColor="@color/auth_light_text"
                    android:textSize="13.5sp" />

                <!-- 3. TARJETA PRINCIPAL DE INICIO DE SESIÓN (LAVANDA CLARO) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/auth_card_bg"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:strokeColor="@color/auth_card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="22dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="20dp">

                        <!-- Título de tarjeta -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/auth_title"
                            android:textColor="@color/auth_ink_heading"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/auth_subtitle"
                            android:textColor="@color/auth_muted"
                            android:textSize="13.5sp" />

                        <!-- Campo Usuario -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:labelFor="@id/et_username"
                            android:text="@string/auth_username"
                            android:textColor="@color/auth_ink"
                            android:textSize="13sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_username"
                            style="@style/Widget.WebSitePlus.AuthInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:errorEnabled="false"
                            app:hintEnabled="false"
                            app:startIconDrawable="@drawable/auth_ic_user">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_username"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="username"
                                android:hint="@string/auth_username_hint"
                                android:imeOptions="actionNext"
                                android:inputType="textNoSuggestions"
                                android:maxLines="1"
                                android:minHeight="52dp"
                                android:singleLine="true"
                                android:textColor="@color/auth_ink"
                                android:textColorHint="@color/auth_muted"
                                android:textSize="14.5sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Campo Contraseña -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:labelFor="@id/et_password"
                            android:text="@string/auth_password"
                            android:textColor="@color/auth_ink"
                            android:textSize="13sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_password"
                            style="@style/Widget.WebSitePlus.AuthInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:endIconMode="password_toggle"
                            app:errorEnabled="false"
                            app:hintEnabled="false"
                            app:startIconDrawable="@drawable/auth_ic_lock">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_password"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="password"
                                android:hint="@string/auth_password_hint"
                                android:imeOptions="actionDone"
                                android:inputType="textPassword"
                                android:maxLines="1"
                                android:minHeight="52dp"
                                android:singleLine="true"
                                android:textColor="@color/auth_ink"
                                android:textColorHint="@color/auth_muted"
                                android:textSize="14.5sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Ayuda / Clave alineada a la derecha -->
                        <TextView
                            android:id="@+id/btn_help"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center_vertical"
                            android:minHeight="36dp"
                            android:paddingStart="6dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="2dp"
                            android:paddingBottom="6dp"
                            android:text="@string/auth_help"
                            android:textColor="@color/auth_brand_purple"
                            android:textSize="12.5sp" />

                        <!-- Fila compacta: Activar acceso con huella -->
                        <LinearLayout
                            android:id="@+id/biometric_toggle_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/auth_biometric_row_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="54dp"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/auth_ic_fingerprint"
                                app:tint="@color/auth_brand_purple" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="@string/auth_remember_biometric"
                                    android:textColor="@color/auth_ink"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tv_biometric_hint"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:lineSpacingExtra="1dp"
                                    android:maxLines="2"
                                    android:text="@string/auth_biometric_opt_in"
                                    android:textColor="@color/auth_muted"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/cb_biometric"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/auth_remember_biometric"
                                app:thumbTint="@color/auth_switch_thumb"
                                app:trackDecorationTint="@android:color/transparent"
                                app:trackTint="@color/auth_switch_track" />
                        </LinearLayout>

                        <!-- Banner de error -->
                        <TextView
                            android:id="@+id/tv_auth_error"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:accessibilityLiveRegion="polite"
                            android:background="@drawable/auth_error_banner_bg"
                            android:drawablePadding="10dp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/auth_error_text"
                            android:textSize="12.5sp"
                            android:visibility="gone"
                            app:drawableStartCompat="@drawable/auth_ic_alert_circle"
                            app:drawableTint="@color/auth_error_text" />

                        <!-- Indicador de carga -->
                        <LinearLayout
                            android:id="@+id/auth_loading_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:accessibilityLiveRegion="polite"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ProgressBar
                                android:id="@+id/progress_bar"
                                style="?android:attr/progressBarStyleSmall"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:indeterminateTint="@color/auth_brand_purple" />

                            <TextView
                                android:id="@+id/tv_auth_loading"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/auth_loading_login"
                                android:textColor="@color/auth_muted"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Botón principal: Iniciar sesión -> -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_login"
                            style="@style/Widget.WebSitePlus.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/auth_btn_primary_bg"
                            android:text="@string/auth_sign_in"
                            app:backgroundTint="@null"
                            app:icon="@drawable/auth_ic_arrow"
                            app:iconGravity="textEnd"
                            app:iconPadding="8dp"
                            app:iconSize="18dp"
                            app:iconTint="@android:color/white" />

                        <!-- Separador: O ingresa con -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:layout_marginBottom="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1"
                                android:background="@color/auth_border" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="@string/auth_quick_access"
                                android:textColor="@color/auth_muted"
                                android:textSize="12.5sp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1"
                                android:background="@color/auth_border" />
                        </LinearLayout>

                        <!-- Otros métodos de ingreso (2 columnas equilibradas) -->
                        <LinearLayout
                            android:id="@+id/biometric_actions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_fingerprint"
                                style="@style/Widget.WebSitePlus.Button.Biometric"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1"
                                android:lineSpacingExtra="1dp"
                                android:maxLines="2"
                                android:text="@string/auth_fingerprint"
                                app:icon="@drawable/auth_ic_fingerprint" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_camera"
                                style="@style/Widget.WebSitePlus.Button.Biometric"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_marginStart="5dp"
                                android:layout_weight="1"
                                android:contentDescription="@string/auth_face_recognition"
                                android:lineSpacingExtra="1dp"
                                android:maxLines="2"
                                android:text="@string/auth_camera"
                                app:icon="@drawable/auth_ic_face_recognition" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
