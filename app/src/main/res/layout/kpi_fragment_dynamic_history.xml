<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- Header Corporativo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/btnHistBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/kpi_senior_bg_stepper_btn"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/kpi_ic_back"
            app:tint="#0F172A" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historial de Entregas"
                android:textColor="#0F172A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Versiones congeladas y auditoría SIGD"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Botón Exportar PDF -->
        <ImageView
            android:id="@+id/btnHistExportPdf"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/kpi_senior_bg_stepper_btn"
            android:clickable="true"
            android:contentDescription="Exportar PDF"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/kpi_ic_document"
            app:tint="#DC2626" />

        <!-- Botón Exportar CSV -->
        <ImageView
            android:id="@+id/btnHistExportCsv"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/kpi_senior_bg_stepper_btn"
            android:clickable="true"
            android:contentDescription="Exportar CSV"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/kpi_ic_chart"
            app:tint="#16A34A" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnHistSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reintentar envío de registros pendientes" />

        <TextView
            android:id="@+id/tvHistSyncStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Barra de Filtros -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filtrar Puesto:"
            android:textColor="#334155"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spHistFilterRole"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/kpi_junior_bg_spinner" />
    </LinearLayout>

    <!-- Resumen Consolidado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/kpi_bg_card_white"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENTREGAS REGISTRADAS"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistTotalCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0 registros"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROMEDIO DE CUMPLIMIENTO"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistAverageCompliance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0.0%"
                android:textColor="#5B21B6"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Lista de Entregas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDynamicHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp" />

    <!-- Estado Vacío -->
    <TextView
        android:id="@+id/tvHistEmptyNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="No se encontraron entregas registradas para este filtro."
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
