<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_bg_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- A. ENCABEZADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/kpi_cfg_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/admin_bg_circle_icon_button"
            android:clickable="true"
            android:contentDescription="Volver"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/admin_ic_chevron_left"
                app:tint="@color/admin_text_primary" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/admin_bg_icon_badge_purple">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/admin_ic_sliders"
                app:tint="@color/admin_purple_accent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Configurar indicador oficial"
                android:textColor="@color/admin_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Define los parámetros de evaluación"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.45"
        android:background="@color/admin_border" />

    <!-- CONTENIDO DESPLAZABLE -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/kpi_cfg_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <!-- Banner inline de error de validación / servidor -->
            <LinearLayout
                android:id="@+id/kpi_cfg_error_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/admin_bg_alert_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@null"
                    android:src="@drawable/admin_ic_info_circle"
                    app:tint="@color/admin_danger_text" />

                <TextView
                    android:id="@+id/kpi_cfg_error_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- B. SECCIÓN 1: INFORMACIÓN GENERAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/admin_bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/admin_bg_icon_badge_purple">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/admin_ic_reports"
                            app:tint="@color/admin_purple_accent" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Información general"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:alpha="0.45"
                    android:background="@color/admin_border" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Código único *"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/kpi_cfg_codigo"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/admin_bg_kpi_input"
                    android:hint="Ej. KPI_ENTREGAS_01"
                    android:imeOptions="actionNext"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="50"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:singleLine="true"
                    android:textColor="@color/admin_text_primary"
                    android:textColorHint="@color/admin_text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="3 a 50 caracteres: mayúsculas, números, _, . o -"
                    android:textColor="@color/admin_text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Nombre del indicador *"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/kpi_cfg_nombre"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/admin_bg_kpi_input"
                    android:hint="Ej. Cumplimiento de entregas semanales"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:maxLength="150"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:singleLine="true"
                    android:textColor="@color/admin_text_primary"
                    android:textColorHint="@color/admin_text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Descripción *"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/kpi_cfg_descripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/admin_bg_kpi_input"
                    android:gravity="top|start"
                    android:hint="Describe cómo se evalúa y qué evidencias respaldan el resultado…"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5"
                    android:minHeight="88dp"
                    android:paddingStart="13dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="13dp"
                    android:paddingBottom="11dp"
                    android:textColor="@color/admin_text_primary"
                    android:textColorHint="@color/admin_text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- C. SECCIÓN 2: MEDICIÓN Y EVALUACIÓN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/admin_bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/admin_bg_icon_badge_purple">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/admin_ic_target"
                            app:tint="@color/admin_purple_accent" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Medición y evaluación"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:alpha="0.45"
                    android:background="@color/admin_border" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Tipo de métrica *"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <!-- Selector visual 2x2 para Tipo de métrica -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:id="@+id/kpi_cfg_metric_numerico"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/admin_bg_ranking_chip_active"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">

                            <ImageView
                                android:id="@+id/kpi_cfg_metric_numerico_check"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginEnd="6dp"
                                android:contentDescription="@null"
                                android:src="@drawable/admin_ic_check"
                                app:tint="@android:color/white" />

                            <TextView
                                android:id="@+id/kpi_cfg_metric_numerico_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="Numérico"
                                android:textColor="@android:color/white"
                                android:textSize="12.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/kpi_cfg_metric_porcentaje"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/admin_bg_ranking_chip_inactive"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">

                            <ImageView
                                android:id="@+id/kpi_cfg_metric_porcentaje_check"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginEnd="6dp"
                                android:contentDescription="@null"
                                android:src="@drawable/admin_ic_check"
                                android:visibility="gone"
                                app:tint="@android:color/white" />

                            <TextView
                                android:id="@+id/kpi_cfg_metric_porcentaje_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="Porcentaje"
                                android:textColor="@color/admin_text_secondary"
                                android:textSize="12.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:id="@+id/kpi_cfg_metric_booleano"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/admin_bg_ranking_chip_inactive"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">

                            <ImageView
                                android:id="@+id/kpi_cfg_metric_booleano_check"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginEnd="6dp"
                                android:contentDescription="@null"
                                android:src="@drawable/admin_ic_check"
                                android:visibility="gone"
                                app:tint="@android:color/white" />

                            <TextView
                                android:id="@+id/kpi_cfg_metric_booleano_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="Booleano"
                                android:textColor="@color/admin_text_secondary"
                                android:textSize="12.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/kpi_cfg_metric_escala"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/admin_bg_ranking_chip_inactive"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp">

                            <ImageView
                                android:id="@+id/kpi_cfg_metric_escala_check"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginEnd="6dp"
                                android:contentDescription="@null"
                                android:src="@drawable/admin_ic_check"
                                android:visibility="gone"
                                app:tint="@android:color/white" />

                            <TextView
                                android:id="@+id/kpi_cfg_metric_escala_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="Escala 1–5"
                                android:textColor="@color/admin_text_secondary"
                                android:textSize="12.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Unidad de medición *"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/kpi_cfg_unidad"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/admin_bg_kpi_input"
                    android:hint="Ej. ACTIVIDADES, VIDEOS, PUBLICACIONES"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLength="30"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:singleLine="true"
                    android:textColor="@color/admin_text_primary"
                    android:textColorHint="@color/admin_text_muted"
                    android:textSize="14sp" />

                <!-- Meta aprobada + Peso aprobado en dos columnas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="Meta aprobada *"
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/kpi_cfg_meta"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/admin_bg_kpi_input"
                            android:hint="Ej. 100"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:singleLine="true"
                            android:textColor="@color/admin_text_primary"
                            android:textColorHint="@color/admin_text_muted"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="Peso aprobado *"
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/kpi_cfg_peso"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/admin_bg_kpi_input"
                            android:hint="1 a 100"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:singleLine="true"
                            android:textColor="@color/admin_text_primary"
                            android:textColorHint="@color/admin_text_muted"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Puntos base aprobados *"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/kpi_cfg_puntos"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/admin_bg_kpi_input"
                    android:hint="Ej. 50"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:singleLine="true"
                    android:textColor="@color/admin_text_primary"
                    android:textColorHint="@color/admin_text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- D. SECCIÓN 3: PROGRAMACIÓN Y RESPONSABLES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/admin_bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/admin_bg_icon_badge_purple">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/admin_ic_calendar"
                            app:tint="@color/admin_purple_accent" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Programación y responsables"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:alpha="0.45"
                    android:background="@color/admin_border" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Período de evaluación *"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <!-- Selector segmentado de período: Diaria | Semanal | Mensual -->
                <FrameLayout
                    android:id="@+id/kpi_cfg_period_segmented"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/admin_bg_ranking_segmented_track"
                    android:padding="3dp">

                    <View
                        android:id="@+id/kpi_cfg_period_indicator"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/admin_bg_segment_active" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <TextView
                            android:id="@+id/kpi_cfg_period_diaria"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="Diaria"
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/kpi_cfg_period_semanal"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="Semanal"
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/kpi_cfg_period_mensual"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="Mensual"
                            android:textColor="@android:color/white"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- ID categoría + ID cargo en dos columnas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="ID de categoría *"
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/kpi_cfg_categoria"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/admin_bg_kpi_input"
                            android:hint="Ej. 1"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:singleLine="true"
                            android:textColor="@color/admin_text_primary"
                            android:textColorHint="@color/admin_text_muted"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="ID del cargo (rol) *"
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/kpi_cfg_cargo"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/admin_bg_kpi_input"
                            android:hint="Ej. 3"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:singleLine="true"
                            android:textColor="@color/admin_text_primary"
                            android:textColorHint="@color/admin_text_muted"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="ID del responsable de revisión *"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/kpi_cfg_responsable"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/admin_bg_kpi_input"
                    android:hint="ID del usuario responsable (ej. 5)"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:singleLine="true"
                    android:textColor="@color/admin_text_primary"
                    android:textColorHint="@color/admin_text_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- E. BARRA INFERIOR FIJA DE ACCIONES -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.5"
        android:background="@color/admin_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/admin_bg_drawer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/kpi_cfg_btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/admin_bg_ranking_period_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="104dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Cancelar"
            android:textColor="@color/admin_text_secondary"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/kpi_cfg_btn_save"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/admin_bg_kpi_primary_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ProgressBar
                android:id="@+id/kpi_cfg_save_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginEnd="8dp"
                android:indeterminate="true"
                android:indeterminateTint="@android:color/white"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/kpi_cfg_save_icon"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/admin_ic_save"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/kpi_cfg_save_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Guardar indicador"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
