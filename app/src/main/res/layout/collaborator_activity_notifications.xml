<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/collab_notifs_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/collab_prog_bg_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 1. ENCABEZADO PREMIUM DEL CENTRO DE NOTIFICACIONES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/collab_bg_header_gradient"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Notificaciones"
                    android:textColor="@color/collab_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/collab_notifs_tv_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Mantente al día con tus actividades"
                    android:textColor="@color/collab_notif_text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- Campana elegante a la derecha con punto de pendientes real -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/collab_bg_notif_header_bell">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:contentDescription="Notificaciones"
                    android:src="@drawable/collab_ic_nav_bell"
                    app:tint="@color/collab_notif_violet_soft" />

                <View
                    android:id="@+id/collab_notifs_header_bell_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/collab_bg_notif_chip_selected"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Fila compacta de estado real + acción global "Marcar todas" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/collab_notifs_tv_unread_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/collab_bg_notif_status_positive"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="Sin pendientes"
                android:textColor="@color/collab_notif_positive"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/collab_notifs_btn_mark_all_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/collab_bg_notif_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="11dp"
                android:paddingTop="5dp"
                android:paddingEnd="11dp"
                android:paddingBottom="5dp"
                android:text="Marcar todas"
                android:textColor="@color/collab_notif_violet_soft"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. CONTENIDO DESPLAZABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <!-- SECCIÓN: MIS AVISOS + CONTADOR REAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mis avisos"
                    android:textColor="@color/collab_text_primary"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/collab_notifs_tv_total_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 notificaciones"
                    android:textColor="@color/collab_notif_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- FILTROS MODERNOS: TODOS · NO LEÍDAS · IMPORTANTES -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/collab_notif_chip_all"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/collab_bg_notif_chip_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="78dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Todos"
                        android:textColor="@android:color/white"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/collab_notif_chip_unread"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/collab_bg_notif_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="No leídas"
                        android:textColor="@color/collab_notif_text_secondary"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/collab_notif_chip_kpi"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/collab_bg_notif_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Importantes"
                        android:textColor="@color/collab_notif_text_secondary"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Tarjeta de Recordatorio Local (oculta para trabajadores reales del servidor) -->
            <LinearLayout
                android:id="@+id/collab_notifs_test_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/collab_bg_notif_empty_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/collab_bg_icon_badge_purple">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/collab_ic_nav_bell"
                        app:tint="@color/collab_notif_violet_soft" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recordatorios locales de KPI"
                        android:textColor="@color/collab_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/collab_notifs_tv_reminder_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Alertas locales activas en Configuración"
                        android:textColor="@color/collab_notif_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/collab_notifs_btn_test_reminder"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/collab_bg_notif_chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Probar alerta"
                    android:textColor="@android:color/white"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Nota de deslizamiento (visible únicamente en modo local con avisos descartables) -->
            <TextView
                android:id="@+id/collab_notifs_swipe_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Desliza un aviso a la izquierda o derecha para quitarlo."
                android:textColor="@color/collab_notif_text_secondary"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <!-- ESTADO 1: CARGANDO (TARJETAS SKELETON DISCRETAS) -->
            <LinearLayout
                android:id="@+id/collab_notifs_loading_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Skeleton 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/collab_bg_notif_card_read"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <View
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/collab_bg_notif_skeleton_bar" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="130dp"
                            android:layout_height="12dp"
                            android:background="@drawable/collab_bg_notif_skeleton_bar" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:layout_marginTop="9dp"
                            android:background="@drawable/collab_bg_notif_skeleton_bar" />

                        <View
                            android:layout_width="180dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/collab_bg_notif_skeleton_bar" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Skeleton 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/collab_bg_notif_card_read"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <View
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/collab_bg_notif_skeleton_bar" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="165dp"
                            android:layout_height="12dp"
                            android:background="@drawable/collab_bg_notif_skeleton_bar" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:layout_marginTop="9dp"
                            android:background="@drawable/collab_bg_notif_skeleton_bar" />

                        <View
                            android:layout_width="140dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/collab_bg_notif_skeleton_bar" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ESTADO 2: ERROR DE CONEXIÓN / PERMISO -->
            <LinearLayout
                android:id="@+id/collab_notifs_error_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/collab_bg_notif_empty_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="24dp"
                android:paddingEnd="22dp"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/collab_bg_icon_badge_red">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="Error al cargar avisos"
                        android:src="@drawable/admin_ic_alert_triangle"
                        app:tint="@color/collab_status_overdue" />
                </FrameLayout>

                <TextView
                    android:id="@+id/collab_notifs_error_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="No se pudieron cargar tus avisos"
                    android:textColor="@color/collab_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/collab_notifs_error_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/collab_notif_text_secondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/collab_notifs_btn_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/collab_bg_notif_chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="Reintentar"
                    android:textColor="@android:color/white"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ESTADO 3: LISTA DE NOTIFICACIONES REALES -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/collab_notifs_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- ESTADO 4: ESTADO VACÍO PREMIUM CON CAMPANA ILUSTRADA -->
            <LinearLayout
                android:id="@+id/collab_notifs_empty_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/collab_bg_notif_empty_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="28dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:contentDescription="Sin avisos pendientes"
                    android:scaleType="fitCenter"
                    android:src="@drawable/collab_ill_notif_empty_bell" />

                <TextView
                    android:id="@+id/collab_notifs_empty_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="¡Todo al día!"
                    android:textColor="@color/collab_text_primary"
                    android:textSize="17.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/collab_notifs_tv_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="No tienes notificaciones por ahora. Cuando haya novedades, aparecerán aquí."
                    android:textColor="@color/collab_notif_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/collab_notifs_empty_status_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/collab_bg_notif_status_positive"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="No hay avisos pendientes"
                    android:textColor="@color/collab_notif_positive"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SECCIÓN INFORMATIVA COMPACTA (solo cuando la bandeja está vacía en "Todos") -->
            <LinearLayout
                android:id="@+id/collab_notifs_info_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¿Qué encontrarás aquí?"
                    android:textColor="@color/collab_notif_text_secondary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <!-- Fila 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/collab_bg_notif_card_read"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Evaluaciones y KPI"
                            android:src="@drawable/collab_ic_notif_clipboard_check"
                            app:tint="@color/collab_notif_violet_soft" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Evaluaciones KPI"
                            android:textColor="@color/collab_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/collab_bg_notif_card_read"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Recompensas"
                            android:src="@drawable/collab_ic_gift"
                            app:tint="@color/collab_prog_gold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Recompensas"
                            android:textColor="@color/collab_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Fila 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/collab_bg_notif_card_read"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Recordatorios"
                            android:src="@drawable/collab_ic_notif_calendar_clock"
                            app:tint="@color/collab_notif_positive" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Recordatorios"
                            android:textColor="@color/collab_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/collab_bg_notif_card_read"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Avisos del equipo"
                            android:src="@drawable/collab_ic_nav_bell"
                            app:tint="@color/collab_notif_violet_soft" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Avisos del equipo"
                            android:textColor="@color/collab_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 3. BARRA DE NAVEGACIÓN INFERIOR SIGD -->
    <include layout="@layout/collaborator_layout_bottom_nav" />

</LinearLayout>
