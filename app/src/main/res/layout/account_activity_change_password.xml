<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/collab_bg_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Encabezado Adaptable a Modo Claro y Modo Oscuro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/collab_bg_header_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/admin_space_lg"
        android:paddingTop="@dimen/admin_space_md"
        android:paddingEnd="@dimen/admin_space_lg"
        android:paddingBottom="@dimen/admin_space_md">

        <!-- Botón Volver -->
        <FrameLayout
            android:id="@+id/account_pwd_btn_back"
            android:layout_width="@dimen/admin_icon_btn_size"
            android:layout_height="@dimen/admin_icon_btn_size"
            android:background="@drawable/collab_bg_circle_button"
            android:clickable="true"
            android:contentDescription="Volver"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/admin_ic_chevron_left"
                app:tint="@color/collab_text_primary" />
        </FrameLayout>

        <!-- Título y Subtítulo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/admin_space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_pwd_title"
                android:textColor="@color/collab_text_primary"
                android:textSize="@dimen/admin_text_xl"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/account_pwd_sub"
                android:textColor="@color/collab_text_secondary"
                android:textSize="@dimen/admin_text_xs" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/collab_bg_icon_badge_purple">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/account_ic_lock"
                app:tint="@color/collab_purple_accent" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/collab_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/admin_space_lg">

            <!-- Tarjeta de Aviso de Seguridad Institucional -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/collab_bg_card_hero"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/collab_bg_icon_badge_purple">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/collab_ic_privacy_shield"
                        app:tint="@color/collab_purple_accent" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Actualización segura de credenciales"
                        android:textColor="@color/collab_text_primary"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/account_pwd_notice"
                        android:textColor="@color/collab_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Contenedor del Formulario con Etiquetas, Placeholders y Ayuda -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/collab_bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. Contraseña Actual -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Contraseña actual *"
                    android:textColor="@color/collab_text_primary"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Requerida para verificar tu identidad antes de continuar."
                    android:textColor="@color/collab_text_secondary"
                    android:textSize="12.5sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/account_pwd_layout_current"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:boxBackgroundColor="@color/collab_bg_input"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/collab_purple_primary"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/collab_ic_eye"
                    app:endIconContentDescription="Mostrar contraseña"
                    app:endIconTint="@color/collab_purple_accent"
                    app:errorEnabled="true"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/account_pwd_et_current"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ingresa tu contraseña actual"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/collab_text_primary"
                        android:textColorHint="@color/collab_text_muted"
                        android:textSize="14.5sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 2. Nueva Contraseña -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="2. Nueva contraseña *"
                    android:textColor="@color/collab_text_primary"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Crea una clave segura distinta a la que utilizas actualmente."
                    android:textColor="@color/collab_text_secondary"
                    android:textSize="12.5sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/account_pwd_layout_new"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:boxBackgroundColor="@color/collab_bg_input"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/collab_purple_primary"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/collab_ic_eye"
                    app:endIconContentDescription="Mostrar contraseña"
                    app:endIconTint="@color/collab_purple_accent"
                    app:errorEnabled="true"
                    app:helperText="Mínimo 8 caracteres, incluyendo al menos 1 letra y 1 número"
                    app:helperTextTextColor="@color/collab_text_secondary"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/account_pwd_et_new"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Escribe tu nueva contraseña"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/collab_text_primary"
                        android:textColorHint="@color/collab_text_muted"
                        android:textSize="14.5sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 3. Confirmar Nueva Contraseña -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="3. Confirmar nueva contraseña *"
                    android:textColor="@color/collab_text_primary"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Vuelve a ingresar tu nueva clave para evitar errores de escritura."
                    android:textColor="@color/collab_text_secondary"
                    android:textSize="12.5sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/account_pwd_layout_confirm"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:boxBackgroundColor="@color/collab_bg_input"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/collab_purple_primary"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/collab_ic_eye"
                    app:endIconContentDescription="Mostrar contraseña"
                    app:endIconTint="@color/collab_purple_accent"
                    app:errorEnabled="true"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/account_pwd_et_confirm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Repite tu nueva contraseña"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/collab_text_primary"
                        android:textColorHint="@color/collab_text_muted"
                        android:textSize="14.5sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Tarjeta de Explicación de Requisitos de Contraseña -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/collab_bg_card_secondary"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Requisitos de seguridad de la contraseña:"
                        android:textColor="@color/collab_purple_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="• Longitud mínima de 8 caracteres.\n• Debe incluir al menos una letra (mayúscula o minúscula) y un número.\n• Debe ser diferente a tu contraseña actual.\n• El cambio definitivo se sincronizará al conectar la API de autenticación del servidor."
                        android:textColor="@color/collab_text_secondary"
                        android:textSize="12.5sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Barra de progreso -->
            <ProgressBar
                android:id="@+id/account_pwd_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- Botón Actualizar Contraseña -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/account_pwd_btn_submit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/collab_purple_primary"
                android:letterSpacing="0.03"
                android:text="@string/account_pwd_submit"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/account_ic_lock"
                app:iconGravity="textStart"
                app:iconTint="@android:color/white" />

            <!-- Botón Cancelar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/account_pwd_btn_cancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:letterSpacing="0.03"
                android:text="@string/account_pwd_cancel"
                android:textAllCaps="false"
                android:textColor="@color/collab_text_primary"
                android:textSize="14.5sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/collab_border" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
