<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/tvRowDayName"
        android:layout_width="65dp"
        android:layout_height="wrap_content"
        android:text="LUNES"
        android:textColor="#1E293B"
        android:textSize="8.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRowAttendanceStatus"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:text="Doble Turno"
        android:textColor="#16A34A"
        android:textSize="8sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/tvRowMorningStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 tareas / 2 piezas ✓"
            android:textColor="#0F172A"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/tvRowMorningHours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="07:56 AM - 01:31 PM"
            android:textColor="#64748B"
            android:textSize="7.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/tvRowAfternoonStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 tareas / 1 video ✓"
            android:textColor="#0F172A"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/tvRowAfternoonHours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01:58 PM - 06:42 PM"
            android:textColor="#64748B"
            android:textSize="7.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRowScore"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="19 / 20"
        android:textColor="#4F46E5"
        android:textSize="8.5sp"
        android:textStyle="bold" />
</LinearLayout>

