<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/personal_bg_card_premium"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingTop="15dp"
    android:paddingEnd="15dp"
    android:paddingBottom="14dp">

    <!-- FILA PRINCIPAL: Avatar + Identidad + Badge de estado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <!-- Avatar circular con indicador de estado -->
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp">

            <FrameLayout
                android:id="@+id/item_personal_avatar_container"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:background="@drawable/personal_bg_avatar_circle">

                <ImageView
                    android:id="@+id/item_personal_iv_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/personal_bg_avatar_circle"
                    android:clipToOutline="true"
                    android:contentDescription="Foto de perfil"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/item_personal_tv_initials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="LP" />
            </FrameLayout>

            <View
                android:id="@+id/item_personal_status_dot"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="1dp"
                android:layout_marginBottom="1dp" />
        </FrameLayout>

        <!-- Columna de datos: Nombre (hasta 2 líneas) + Estado + Cargo + Agencia -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Fila superior: Nombre + Badge de estado + Chevron -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/item_personal_tv_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:textColor="@color/personal_text_primary"
                    android:textSize="15.5sp"
                    android:textStyle="bold"
                    tools:text="Luis Paredes Mendoza" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/item_personal_tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/personal_bg_status_active_pill"
                        android:maxLines="1"
                        android:paddingStart="9dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/personal_status_delivered"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="Activo" />

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/admin_ic_chevron_right"
                        app:tint="@color/personal_text_muted" />
                </LinearLayout>
            </LinearLayout>

            <!-- Cargo con ícono discreto -->
            <LinearLayout
                android:id="@+id/item_personal_role_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/personal_ic_briefcase"
                    app:tint="@color/personal_text_secondary" />

                <TextView
                    android:id="@+id/item_personal_tv_role"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/personal_text_secondary"
                    android:textSize="12.5sp"
                    tools:text="Senior Backend Developer" />
            </LinearLayout>

            <!-- Agencia y código con ícono building-2 -->
            <LinearLayout
                android:id="@+id/item_personal_meta_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/personal_ic_building_2"
                    app:tint="@color/personal_text_muted" />

                <TextView
                    android:id="@+id/item_personal_tv_meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/personal_text_muted"
                    android:textSize="11.5sp"
                    tools:text="Agencia Chiclayo · #1001" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- FILA OPCIONAL DE KPI Y ACTIVIDADES (solo visible cuando el servidor envía datos) -->
    <LinearLayout
        android:id="@+id/item_personal_kpi_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/item_personal_tv_kpi_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/personal_bg_kpi_pill"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/personal_purple_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="94% KPI" />

        <TextView
            android:id="@+id/item_personal_tv_activities"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/personal_text_secondary"
            android:textSize="11.5sp"
            tools:text="15/16 actividades" />
    </LinearLayout>

    <!-- SEPARADOR SUTIL -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="11dp"
        android:background="@color/personal_divider" />

    <!-- BOTONES DE ACCIÓN REALES: REPORTES + VER PERFIL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:weightSum="2">

        <LinearLayout
            android:id="@+id/item_personal_btn_reports"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/personal_bg_btn_secondary_premium"
            android:clickable="true"
            android:contentDescription="Ver reportes recibidos del trabajador"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/admin_ic_file_check_2"
                app:tint="@color/personal_purple_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Reportes"
                android:textColor="@color/personal_text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_personal_btn_profile"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/personal_bg_btn_primary_premium"
            android:clickable="true"
            android:contentDescription="Ver perfil del colaborador"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/personal_ic_user_round"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ver perfil"
                android:textColor="@android:color/white"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
