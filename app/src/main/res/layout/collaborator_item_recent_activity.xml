<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/collab_bg_card_secondary"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Icono Badge -->
    <FrameLayout
        android:id="@+id/collab_fl_item_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/collab_bg_icon_badge_purple">

        <ImageView
            android:id="@+id/collab_iv_item_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/collaborator_ic_check_circle"
            app:tint="@color/collab_purple_accent" />
    </FrameLayout>

    <!-- Textos Centrales -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/collab_tv_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/collab_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/collab_tv_item_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/collab_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Tiempo y Chevron -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/collab_tv_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/collab_text_muted"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/admin_ic_chevron_right"
            app:tint="@color/collab_text_muted" />
    </LinearLayout>

</LinearLayout>
