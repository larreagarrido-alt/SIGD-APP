<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_bg_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/admin_bg_header_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/monthly_btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/admin_bg_circle_icon_button"
            android:clickable="true"
            android:contentDescription="Volver"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/admin_ic_chevron_left"
                app:tint="@color/admin_text_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Evaluación mensual"
                android:textColor="@color/admin_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Participación y tendencias de bienestar"
                android:textColor="@color/admin_text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/monthly_btn_refresh"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/admin_bg_circle_icon_button"
            android:clickable="true"
            android:contentDescription="Actualizar"
            android:focusable="true">

            <ImageView
                android:id="@+id/monthly_refresh_icon"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/admin_ic_refresh"
                app:tint="@color/admin_purple_accent" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <!-- BANNER DE ESTADO / ERROR -->
            <TextView
                android:id="@+id/monthly_status_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/admin_bg_wellness_stat_card"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:text="Consultando datos del servidor…"
                android:textColor="@color/admin_text_secondary"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <!-- 1. SECCIÓN COMPACTA DE FILTROS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/admin_bg_wellness_surface"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Selector de período mensual (abre calendario de mes y año) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/admin_bg_wellness_stat_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">

                    <FrameLayout
                        android:id="@+id/monthly_btn_prev_month"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:clickable="true"
                        android:contentDescription="Mes anterior"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/admin_ic_chevron_left"
                            app:tint="@color/admin_purple_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/monthly_btn_pick_period"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/admin_ic_calendar_days"
                            app:tint="@color/admin_purple_accent" />

                        <TextView
                            android:id="@+id/monthly_tv_period"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/admin_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="5dp"
                            android:contentDescription="@null"
                            android:src="@drawable/admin_ic_chevron_down"
                            app:tint="@color/admin_text_secondary" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/monthly_btn_next_month"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:clickable="true"
                        android:contentDescription="Mes siguiente"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/admin_ic_chevron_right"
                            app:tint="@color/admin_purple_accent" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Selectores Agencia + Campaña en fila compacta con íconos Lucide -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/monthly_filter_agency"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/admin_bg_wellness_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="6dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/admin_ic_building"
                            app:tint="@color/admin_purple_accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="Agencia"
                                android:textColor="@color/admin_text_secondary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/monthly_tv_agency"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="Todas"
                                android:textColor="@color/admin_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/admin_ic_chevron_down"
                            app:tint="@color/admin_text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/monthly_filter_campaign"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/admin_bg_wellness_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="6dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/admin_ic_calendar_range"
                            app:tint="@color/admin_cyan_brain" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="Campaña"
                                android:textColor="@color/admin_text_secondary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/monthly_tv_campaign"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="Todas"
                                android:textColor="@color/admin_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/admin_ic_chevron_down"
                            app:tint="@color/admin_text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 2. DASHBOARD DE PARTICIPACIÓN MENSUAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    android:src="@drawable/admin_ic_chart_pie"
                    app:tint="@color/admin_purple_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:letterSpacing="0.07"
                    android:text="PARTICIPACIÓN DEL PERÍODO"
                    android:textColor="@color/admin_purple_accent"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/admin_bg_wellness_surface"
                android:orientation="vertical"
                android:padding="13dp">

                <!-- Fila superior: Elegibles (lavanda) + Completadas (verde menta) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/admin_bg_wellness_stat_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:id="@+id/monthly_badge_eligible"
                                android:layout_width="32dp"
                                android:layout_height="32dp">

                                <ImageView
                                    android:layout_width="17dp"
                                    android:layout_height="17dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/admin_ic_users_round"
                                    app:tint="@color/admin_purple_accent" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Elegibles"
                                android:textColor="@color/admin_text_primary"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/monthly_stat_eligible"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="—"
                            android:textColor="@color/admin_text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Participantes elegibles"
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/admin_bg_wellness_stat_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:id="@+id/monthly_badge_completed"
                                android:layout_width="32dp"
                                android:layout_height="32dp">

                                <ImageView
                                    android:layout_width="17dp"
                                    android:layout_height="17dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/collab_ic_notif_clipboard_check"
                                    app:tint="@color/admin_status_delivered" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Completadas"
                                android:textColor="@color/admin_text_primary"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/monthly_stat_completed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="—"
                            android:textColor="@color/admin_text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Evaluaciones completadas"
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Tarjeta destacada de Participación (%) con chart-pie azul suave + anillo real -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/admin_bg_wellness_stat_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="13dp">

                    <FrameLayout
                        android:id="@+id/monthly_badge_participation"
                        android:layout_width="42dp"
                        android:layout_height="42dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/admin_ic_chart_pie"
                            app:tint="@color/admin_cyan_brain" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Participación"
                            android:textColor="@color/admin_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/monthly_stat_participation_note"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Calculada sobre colaboradores elegibles del período"
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="58dp"
                        android:layout_height="58dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/monthly_participation_ring"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:progress="0"
                            android:visibility="gone"
                            app:indicatorColor="@color/admin_cyan_brain"
                            app:indicatorSize="58dp"
                            app:trackColor="@color/admin_border"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="5dp" />

                        <TextView
                            android:id="@+id/monthly_stat_participation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="—"
                            android:textColor="@color/admin_cyan_brain"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Los datos de participación son agregados y no indican el estado psicológico individual del equipo."
                    android:textColor="@color/admin_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 3. RESULTADOS DEL PERÍODO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    android:src="@drawable/admin_ic_calendar_heart"
                    app:tint="@color/admin_purple_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:letterSpacing="0.07"
                    android:text="RESULTADOS DEL PERÍODO"
                    android:textColor="@color/admin_purple_accent"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/monthly_results_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/admin_bg_wellness_surface"
                android:orientation="vertical"
                android:padding="14dp" />

            <!-- 4. EVOLUCIÓN MENSUAL DEL EQUIPO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    android:src="@drawable/admin_ic_chart_line"
                    app:tint="@color/admin_purple_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:letterSpacing="0.07"
                    android:text="EVOLUCIÓN MENSUAL DEL EQUIPO"
                    android:textColor="@color/admin_purple_accent"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/monthly_trend_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/admin_bg_wellness_surface"
                android:orientation="vertical"
                android:padding="14dp" />

            <!-- 5. ACTIVIDADES DE BIENESTAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    android:src="@drawable/collab_ic_notif_heart_handshake"
                    app:tint="@color/admin_purple_accent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:letterSpacing="0.07"
                    android:text="ACTIVIDADES DE BIENESTAR"
                    android:textColor="@color/admin_purple_accent"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/monthly_btn_add_plan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/admin_bg_wellness_primary_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="13dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="13dp"
                    android:paddingBottom="7dp"
                    android:text="+ Nueva actividad"
                    android:textColor="@android:color/white"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/monthly_plans_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/admin_bg_wellness_surface"
                android:orientation="vertical"
                android:padding="14dp" />

            <!-- ASISTENTE SIGD DE ORIENTACIÓN ORGANIZACIONAL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.07"
                android:text="ORIENTACIÓN ORGANIZACIONAL"
                android:textColor="@color/admin_purple_accent"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/admin_bg_wellness_surface"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/sigd_bg_brand_logo_contrast"
                        android:paddingStart="6dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="4dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="38dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/auth_logo_description"
                            android:scaleType="fitCenter"
                            android:src="@drawable/auth_sigd_logo_transparent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Asistente SIGD"
                            android:textColor="@color/admin_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Orientación para la gestión del bienestar"
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Consulta ideas prácticas sobre comunicación, carga de trabajo, pausas y actividades de bienestar."
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="12sp" />

                <!-- Accesos rápidos interactivos a preguntas frecuentes -->
                <LinearLayout
                    android:id="@+id/monthly_assistant_quick_questions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/monthly_assistant_open_chat"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/admin_bg_wellness_primary_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/collab_ic_send"
                        app:tint="@android:color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Abrir Asistente SIGD"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Este asistente proporciona orientación general y no sustituye la atención de un profesional."
                    android:textColor="@color/admin_text_muted"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
