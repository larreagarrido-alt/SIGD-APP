<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/admin_dash_badge_purple_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/admin_purple_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/admin_dash_surface_secondary" />
            <stroke
                android:width="1dp"
                android:color="@color/admin_border" />
        </shape>
    </item>
</selector>
