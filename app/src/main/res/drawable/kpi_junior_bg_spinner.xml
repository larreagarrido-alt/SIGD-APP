<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kpi_input_bg" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1.2dp"
                android:color="@color/kpi_border" />
        </shape>
    </item>
    <item
        android:width="18dp"
        android:height="18dp"
        android:drawable="@drawable/kpi_ic_dropdown_arrow"
        android:gravity="end|center_vertical"
        android:end="10dp"
        android:right="10dp" />
</layer-list>
