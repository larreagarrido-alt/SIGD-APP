<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#291445"
                android:startColor="#482173" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1.3dp"
                android:color="#B54CFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#221236"
                android:startColor="#3A1B5E" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1.2dp"
                android:color="#8B30E0" />
        </shape>
    </item>
</selector>
