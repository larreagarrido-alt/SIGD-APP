<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="8dp" />
            <solid android:color="@color/kpi_border" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="8dp" />
                <gradient
                    android:angle="0"
                    android:startColor="@color/kpi_progress_start"
                    android:centerColor="@color/kpi_progress_mid"
                    android:endColor="@color/kpi_progress_end" />
            </shape>
        </clip>
    </item>
</layer-list>
