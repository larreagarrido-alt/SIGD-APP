<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep corporate violet base gradient (#21083B -> #310654 -> #1B0631) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/auth_background"
                android:centerColor="@color/auth_background_mid"
                android:endColor="@color/auth_background_bottom" />
        </shape>
    </item>

    <!-- Soft top-center ambient violet illumination behind SIGD logo -->
    <item
        android:width="360dp"
        android:height="300dp"
        android:gravity="top|center_horizontal"
        android:top="-70dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:startColor="#429517D5"
                android:endColor="#009517D5" />
        </shape>
    </item>

    <!-- Subtle upper-right violet depth glow -->
    <item
        android:width="300dp"
        android:height="300dp"
        android:gravity="top|end"
        android:top="40dp"
        android:right="-120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="150dp"
                android:startColor="#267209B7"
                android:endColor="#007209B7" />
        </shape>
    </item>

    <!-- Subtle lower-left violet depth glow -->
    <item
        android:width="340dp"
        android:height="280dp"
        android:gravity="bottom|start"
        android:bottom="-90dp"
        android:left="-90dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:startColor="#249517D5"
                android:endColor="#0021083B" />
        </shape>
    </item>
</layer-list>
