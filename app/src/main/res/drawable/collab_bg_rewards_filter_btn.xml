<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="@color/collab_prog_violet_glow"
                android:startColor="@color/collab_prog_violet_primary" />
            <stroke
                android:width="1.2dp"
                android:color="#E2AEFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/collab_prog_surface_secondary" />
            <stroke
                android:width="1.2dp"
                android:color="@color/collab_prog_violet_glow" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/collab_prog_card_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/collab_prog_border" />
        </shape>
    </item>
</selector>
