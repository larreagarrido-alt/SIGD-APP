<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/personal_card_bg" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.3dp"
                android:color="@color/personal_purple_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/personal_card_bg" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/personal_border" />
        </shape>
    </item>
</selector>
