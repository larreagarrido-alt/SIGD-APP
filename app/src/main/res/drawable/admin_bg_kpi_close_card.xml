<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/admin_surface_tertiary" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1.2dp"
                android:color="@color/admin_purple_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/admin_surface_secondary" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1.2dp"
                android:color="@color/admin_border_light" />
        </shape>
    </item>
</selector>
