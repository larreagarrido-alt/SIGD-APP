<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/admin_surface_tertiary" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="@color/admin_purple_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/admin_status_assigned_bg" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#4A2B70" />
        </shape>
    </item>
</selector>
