<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#641EB5" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#D596FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#B54CFF"
                android:startColor="#8B30E0" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#4DDFA6FF" />
        </shape>
    </item>
</selector>
