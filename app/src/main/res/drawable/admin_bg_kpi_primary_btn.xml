<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#4B2B77" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#6F2CD6" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/admin_purple_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/admin_purple_primary" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/admin_purple_highlight" />
        </shape>
    </item>
</selector>
