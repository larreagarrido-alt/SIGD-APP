<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/collab_prog_surface_secondary" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/collab_notif_unread_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/collab_prog_card_bg" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/collab_notif_border" />
        </shape>
    </item>
</selector>
