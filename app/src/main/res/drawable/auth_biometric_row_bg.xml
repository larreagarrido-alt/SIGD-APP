<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/auth_soft_pressed" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/auth_brand_purple" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/auth_soft" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/auth_border" />
        </shape>
    </item>
</selector>
