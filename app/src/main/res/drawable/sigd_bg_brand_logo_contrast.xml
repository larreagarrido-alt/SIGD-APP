<?xml version="1.0" encoding="utf-8"?>
<!-- Superficie de contraste en Modo Claro para que el logotipo transparente SIGD (blanco/violeta) sea 100% legible -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:endColor="#3A1466"
        android:startColor="#6A22C9"
        android:type="linear" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="#A970F5" />
</shape>
