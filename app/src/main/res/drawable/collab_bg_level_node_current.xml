<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/collab_prog_violet_glow_soft" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="@color/collab_prog_violet_primary"
                android:startColor="@color/collab_prog_violet_glow" />
            <stroke
                android:width="1.8dp"
                android:color="@android:color/white" />
        </shape>
    </item>
</layer-list>
