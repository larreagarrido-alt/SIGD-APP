<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D8738F5" />
            <stroke
                android:width="1dp"
                android:color="@color/admin_purple_accent" />
            <corners android:radius="99dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/admin_dash_badge_purple_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/admin_purple_primary" />
            <corners android:radius="99dp" />
        </shape>
    </item>
</selector>
