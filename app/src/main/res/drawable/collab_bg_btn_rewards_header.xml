<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/collab_purple_dark" />
            <corners android:radius="99dp" />
            <stroke
                android:width="1dp"
                android:color="@color/collab_prog_violet_glow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/collab_prog_violet_glow"
                android:startColor="@color/collab_prog_violet_primary" />
            <corners android:radius="99dp" />
        </shape>
    </item>
</selector>
